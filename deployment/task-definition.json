{
  "family": "kudos-board-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::996255343850:role/kudos-board-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::996255343850:role/kudos-board-ecs-task-role",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "containerDefinitions": [{
    "name": "kudos-board-api",
    "image": "996255343850.dkr.ecr.eu-west-1.amazonaws.com/kudos-board-api:checkpoint-1",
    "essential": true,
    "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
    "environment": [
      { "name": "PORT", "value": "3000" },
      { "name": "DYNAMODB_TABLE_NAME", "value": "kudos-board-checkpoint1" },
      { "name": "AWS_REGION", "value": "eu-west-1" },
      { "name": "ALLOWED_ORIGINS", "value": "http://localhost:4173" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/kudos-board-api",
        "awslogs-region": "eu-west-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }],
  "tags": [
    { "key": "Project", "value": "project-7" },
    { "key": "Stage", "value": "checkpoint-1" }
  ]
}
